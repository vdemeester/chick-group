#!/usr/bin/env bash
# Check whether README.md contains the generated package table.
set -euo pipefail

if [ ! -f README.md ]; then
  echo "Error: README.md not found" >&2
  exit 1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
cp README.md "$tmpdir/README.md"

README="$tmpdir/README.md" ./generate-package-table >/dev/null
if ! diff -u README.md "$tmpdir/README.md"; then
  echo "Error: README.md package table is out of date!" >&2
  echo "Please run './generate-package-table' to update it." >&2
  exit 1
fi

echo "✓ README.md package table is up to date"
